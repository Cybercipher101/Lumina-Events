NODE_ENV=development
API_PORT=5000
FRONTEND_PORT=3000
# Existing PORT=5000 remains supported if API_PORT is not set.
# A standalone MongoDB server is supported; no database upgrade is required.
MONGO_URI=mongodb://127.0.0.1:27017/lumina
# npm run setup generates a private JWT secret in .env if .env does not exist.
JWT_SECRET=
JWT_EXPIRE=30d

# Local development: use MongoDB Atlas or a replica set, never a standalone server.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/lumina?replicaSet=rs0
# Generate a unique value: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-generated-secret
JWT_EXPIRE=7d
# Empty in production when the frontend and API are served by the same app.
CORS_ORIGINS=http://localhost:3000
# Set to the exact trusted proxy hop count for your hosting provider.
TRUST_PROXY=0
